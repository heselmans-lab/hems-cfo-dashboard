# ==============================================================================
# HEMS CFO Dashboard — Environment Variables Example
# ==============================================================================

# Database Connection (Neon Postgres)
DATABASE_URL="postgres://user:password@ep-host.eu-central-1.aws.neon.tech/hems?sslmode=require"
POSTGRES_URL="postgres://user:password@ep-host.eu-central-1.aws.neon.tech/hems?sslmode=require"

# NextAuth.js Configuration
NEXTAUTH_URL="https://hems-cfo-dashboard.vercel.app"
NEXTAUTH_SECRET="generate-a-strong-random-32-byte-hex-string-using-openssl-rand-hex-32"

# Google OAuth Credentials (from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"

# Role-Based Least-Privilege Access Control (Comma-separated lowercase emails)
# HEMS_ADMIN_EMAILS: Full access to all sites (Kruisstraat Duffel + Bomma Tessenderlo)
HEMS_ADMIN_EMAILS="heselmans@gmail.com,kmeeus@gmail.com"

# HEMS_TESSENDERLO_EMAILS: Strictly restricted to Bomma Tessenderlo ONLY (Family)
# Kruisstraat Duffel remains completely invisible and blocked server-side for these accounts.
HEMS_TESSENDERLO_EMAILS="alain.heselmans1@gmail.com,fheselmans@gmail.com,boboheselmans@gmail.com"
